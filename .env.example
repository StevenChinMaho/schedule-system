# 資料庫
# DB_HOST 不需設定：資料庫為專案內的 hn-db 容器，主機名已固定寫在 compose 中。
# 各校的資料庫名稱定義於 includes/schools.php，此處僅需共用的應用程式帳號。
DB_USER=schedule_user
DB_PASS=
# root 密碼供備份與 database/add-school.sh 使用，應與上方的 DB_PASS 不同
DB_ROOT_PASS=

# Cloudflare Tunnel
# 於 Cloudflare Dashboard > Zero Trust > Networks > Tunnels 建立 tunnel 後複製取得。
# 每間學校在同一條 tunnel 底下各新增一個 public hostname，
# service 一律指向 http://hn-web:80
TUNNEL_TOKEN=
