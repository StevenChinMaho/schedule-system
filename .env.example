# 資料庫
# DB_HOST 不需設定：資料庫為專案內的 hn-db 容器，主機名已固定寫在 compose 中。
DB_NAME=hn_schedule
DB_USER=schedule_user
DB_PASS=
# root 密碼僅供備份與維護使用，應與上方的 DB_PASS 不同
DB_ROOT_PASS=

# Cloudflare Tunnel
# 於 Cloudflare Dashboard > Zero Trust > Networks > Tunnels 建立 tunnel 後複製取得，
# 並將 public hostname 的 service 指向 http://hn-web:80
TUNNEL_TOKEN=
